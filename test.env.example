# This file configures only the isolated local integration/browser-test database.
# Copy it to the ignored .env.test file and replace both password placeholders.
MYSQL_TEST_HOST_PORT=3308
MYSQL_TEST_PASSWORD=replace-with-a-dedicated-test-app-password
MYSQL_TEST_ROOT_PASSWORD=replace-with-a-dedicated-test-root-password
TEST_DATABASE_URL=mysql://orders_hub_test_app:replace-with-a-dedicated-test-app-password@127.0.0.1:3308/orders_hub_test
