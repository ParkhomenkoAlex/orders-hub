# Copy this file to .env and replace every password before starting MySQL.
MYSQL_HOST_PORT=3307
MYSQL_DATABASE=orders_hub
MYSQL_USER=orders_hub_app
MYSQL_PASSWORD=replace-with-a-local-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
DATABASE_URL=mysql://orders_hub_app:replace-with-a-local-app-password@127.0.0.1:3307/orders_hub

# Local Socket.IO active-tab service. Run `npm run realtime:dev` separately from
# Next.js. Browser-visible URLs use NEXT_PUBLIC_; allowed origins belong only to
# the service process and are comma-separated exact origins.
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
REALTIME_PORT=3001
REALTIME_ALLOWED_ORIGINS=http://localhost:3000

# Render supplies PORT automatically. For the deployed single-instance service,
# use the exact Vercel Preview origin (no trailing slash); optionally add the
# local Next.js origin after a comma when testing the deployed service locally.
# NODE_ENV=production
# REALTIME_ALLOWED_ORIGINS=https://<vercel-preview-host>

# Remote Aiven Preview runtime only: use Aiven's Service URI with its path changed
# from /defaultdb to /orders_hub, and set DATABASE_SSL_CA to the downloaded Aiven
# project CA PEM. Keep certificate line breaks escaped as \n in environment variables.
# DATABASE_URL=mysql://<user>:<password>@<host>:<port>/orders_hub?ssl-mode=REQUIRED
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Remote migrations only: do not use DATABASE_URL. db:migrate:aiven accepts only
# these Aiven variables and requires /orders_hub plus ssl-mode=REQUIRED.
# AIVEN_DATABASE_URL=mysql://<user>:<password>@<host>:<port>/orders_hub?ssl-mode=REQUIRED
# AIVEN_DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
